APP_NAME="Fazenda Santa Bárbara"
APP_ENV=production
# Obrigatoria. Gere uma vez e nunca troque: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
# Endereco publico: as URLs das fotos sao montadas a partir dele.
APP_URL=http://SEU_IP_AQUI
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Porta publicada no droplet. Troque se outro projeto ja usar a 80.
APP_PORT=80

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=fazenda
DB_USERNAME=fazenda_user
# Use apenas letras e numeros. Gere com: openssl rand -hex 32
DB_PASSWORD=TROCAR_POR_SENHA_FORTE

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Regras de negocio da pecuaria (config/pecuaria.php)
PECUARIA_DIAS_GESTACAO=283
PECUARIA_DIAS_PARA_TOQUE=35
PECUARIA_DIAS_ANTE_PARTO_SECAGEM=60
PECUARIA_DIAS_DESMAME_BEZERRO=210
PECUARIA_DISCO_FOTOS=public
PECUARIA_DIAS_RETROATIVOS_CASEIRO=3
